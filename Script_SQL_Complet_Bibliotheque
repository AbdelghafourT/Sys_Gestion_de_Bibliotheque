-- ============================================
-- 1. MODÈLE CONCEPTUEL DE DONNÉES (MCD)
-- ============================================
/*
Relations et cardinalités :

AUTEUR (1,n) ECRIRE (1,n) LIVRE : Un auteur écrit un ou plusieurs livres, un livre est écrit par un ou plusieurs auteurs
EDITEUR (1,n) édite (0,1) LIVRE : Un éditeur édite plusieurs livres, un livre est édité par un seul éditeur
LECTEUR (1,n) EMPRUNT (0,1) LIVRE : Un lecteur peut emprunter plusieurs livres, un livre peut être emprunté par plusieurs lecteurs
*/

-- ============================================
-- 2. MODÈLE LOGIQUE DE DONNÉES (MLD)
-- ============================================

/*
AUTEUR (<u>id_auteur</u>, nom, prenom, date_naissance)
EDITEUR (<u>id_editeur</u>, nom, adresse)
LIVRE (<u>ISBN</u>, titre, annee_publication, #id_editeur)
LECTEUR (<u>id_lecteur</u>, nom, prenom, adresse)
ECRIRE (<u>#id_auteur, #ISBN</u>)
EMPRUNT (<u>id_emprunt</u>, #id_lecteur, #ISBN, date_emprunt, date_retour)
*/

-- ============================================
-- CRÉATION DES TABLES
-- ============================================

-- Table EDITEUR
CREATE TABLE EDITEUR (
    id_editeur SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    adresse VARCHAR(255)
);

-- Table LIVRE
CREATE TABLE LIVRE (
    ISBN VARCHAR(20) PRIMARY KEY,
    titre VARCHAR(200) NOT NULL,
    annee_publication INT,
    id_editeur INT NOT NULL,
    CONSTRAINT fk_livre_editeur FOREIGN KEY (id_editeur) 
        REFERENCES EDITEUR(id_editeur) ON DELETE RESTRICT
);

-- Table AUTEUR
CREATE TABLE AUTEUR (
    id_auteur SERIAL PRIMARY KEY,
    nom VARCHAR(50) NOT NULL,
    prenom VARCHAR(50) NOT NULL,
    date_naissance DATE
);

-- Table ECRIRE (relation N:N entre AUTEUR et LIVRE)
CREATE TABLE ECRIRE (
    id_auteur INT,
    ISBN VARCHAR(20),
    PRIMARY KEY (id_auteur, ISBN),
    CONSTRAINT fk_ecrire_auteur FOREIGN KEY (id_auteur) 
        REFERENCES AUTEUR(id_auteur) ON DELETE CASCADE,
    CONSTRAINT fk_ecrire_livre FOREIGN KEY (ISBN) 
        REFERENCES LIVRE(ISBN) ON DELETE CASCADE
);

-- Table LECTEUR
CREATE TABLE LECTEUR (
    id_lecteur SERIAL PRIMARY KEY,
    nom VARCHAR(50) NOT NULL,
    prenom VARCHAR(50) NOT NULL,
    adresse VARCHAR(255)
);

-- Table EMPRUNT
CREATE TABLE EMPRUNT (
    id_emprunt SERIAL PRIMARY KEY,
    id_lecteur INT NOT NULL,
    ISBN VARCHAR(20) NOT NULL,
    date_emprunt DATE NOT NULL,
    date_retour DATE,
    CONSTRAINT fk_emprunt_lecteur FOREIGN KEY (id_lecteur) 
        REFERENCES LECTEUR(id_lecteur) ON DELETE RESTRICT,
    CONSTRAINT fk_emprunt_livre FOREIGN KEY (ISBN) 
        REFERENCES LIVRE(ISBN) ON DELETE RESTRICT,
    CONSTRAINT chk_dates CHECK (date_retour IS NULL OR date_retour >= date_emprunt)
);

-- Création d'index pour améliorer les performances
CREATE INDEX idx_emprunt_lecteur ON EMPRUNT(id_lecteur);
CREATE INDEX idx_emprunt_isbn ON EMPRUNT(ISBN);
CREATE INDEX idx_emprunt_date_retour ON EMPRUNT(date_retour);
CREATE INDEX idx_livre_editeur ON LIVRE(id_editeur);
CREATE INDEX idx_ecrire_auteur ON ECRIRE(id_auteur);
CREATE INDEX idx_ecrire_isbn ON ECRIRE(ISBN);

