-- ============================================
-- REQUÊTES DE SÉLECTION
-- ============================================

-- 5. Sélectionner tous les livres empruntés par un lecteur donné
-- Exemple : lecteur avec id_lecteur = 1 (Fatima Benali)
SELECT L.ISBN, L.titre, L.annee_publication, E.date_emprunt, E.date_retour
FROM LIVRE L
INNER JOIN EMPRUNT E ON L.ISBN = E.ISBN
WHERE E.id_lecteur = 1;

-- 6. Sélectionner tous les livres disponibles (non empruntés) à une date donnée
-- Livres qui ne sont pas en cours d'emprunt (date_retour IS NOT NULL ou pas d'emprunt)
SELECT L.ISBN, L.titre, L.annee_publication, ED.nom AS editeur
FROM LIVRE L
INNER JOIN EDITEUR ED ON L.id_editeur = ED.id_editeur
WHERE L.ISBN NOT IN (
    SELECT ISBN 
    FROM EMPRUNT 
    WHERE date_retour IS NULL
);

-- 7. Sélectionner tous les lecteurs ayant des livres en retard
-- Considérant qu'un emprunt doit être retourné dans les 15 jours
SELECT DISTINCT LEC.id_lecteur, LEC.nom, LEC.prenom, LEC.adresse,
       L.titre, E.date_emprunt,
       CURRENT_DATE - E.date_emprunt AS jours_emprunt
FROM LECTEUR LEC
INNER JOIN EMPRUNT E ON LEC.id_lecteur = E.id_lecteur
INNER JOIN LIVRE L ON E.ISBN = L.ISBN
WHERE E.date_retour IS NULL 
  AND (CURRENT_DATE - E.date_emprunt) > 15
ORDER BY jours_emprunt DESC;

-- 8. Sélectionner tous les emprunts en cours avec détails du livre et du lecteur
SELECT E.id_emprunt, E.date_emprunt,
       LEC.nom AS lecteur_nom, LEC.prenom AS lecteur_prenom,
       L.ISBN, L.titre, L.annee_publication,
       ED.nom AS editeur,
       CURRENT_DATE - E.date_emprunt AS jours_emprunt
FROM EMPRUNT E
INNER JOIN LECTEUR LEC ON E.id_lecteur = LEC.id_lecteur
INNER JOIN LIVRE L ON E.ISBN = L.ISBN
INNER JOIN EDITEUR ED ON L.id_editeur = ED.id_editeur
WHERE E.date_retour IS NULL
ORDER BY E.date_emprunt;

-- 9. Sélectionner tous les auteurs qui n'ont pas de livres empruntés
-- (aucun emprunt en cours pour leurs livres)
SELECT DISTINCT A.id_auteur, A.nom, A.prenom, A.date_naissance
FROM AUTEUR A
WHERE A.id_auteur NOT IN (
    SELECT DISTINCT EC.id_auteur
    FROM ECRIRE EC
    INNER JOIN EMPRUNT E ON EC.ISBN = E.ISBN
    WHERE E.date_retour IS NULL
);

-- 10. Sélectionner tous les livres empruntés et leur statut
SELECT L.ISBN, L.titre, L.annee_publication,
       LEC.nom AS lecteur_nom, LEC.prenom AS lecteur_prenom,
       E.date_emprunt, E.date_retour,
       CASE 
           WHEN E.date_retour IS NULL THEN 'Emprunté'
           ELSE 'Retourné'
       END AS statut,
       CASE 
           WHEN E.date_retour IS NULL 
                AND (CURRENT_DATE - E.date_emprunt) > 15 
           THEN 'En retard'
           WHEN E.date_retour IS NULL THEN 'Dans les délais'
           ELSE 'Complété'
       END AS etat
FROM LIVRE L
INNER JOIN EMPRUNT E ON L.ISBN = E.ISBN
INNER JOIN LECTEUR LEC ON E.id_lecteur = LEC.id_lecteur
ORDER BY E.date_emprunt DESC;